# Copia a .env solo para probar en tu PC. En producción se cargan en Vercel (Settings > Environment Variables).

# CMS en la nube (Keystatic Cloud). Formato: equipo/proyecto. Sin esta variable el CMS guarda en tu disco.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# Dominio propio (opcional). Si no se define, se usa la URL de producción que Vercel asigna sola.
PUBLIC_SITE_URL=

# Formulario de contacto (Resend). Sin estas dos variables el formulario avisa que no está activo.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Respaldo: los correos se configuran en el CMS (Configuración general → Correos de los formularios).
# Remitente: con dominio verificado en Resend, ej: TransformAcción720 <web@transformaccion720.com>
CONTACT_FROM_EMAIL=

# Panel Métricas del CMS (Google Analytics + Search Console). Ver README → Publicar → Google.
# En Vercel: el contenido completo del JSON de la cuenta de servicio. En tu PC puedes usar la ruta del archivo
# (fuera de esta carpeta) con GOOGLE_SERVICE_ACCOUNT_FILE. Los IDs se ponen en el CMS, no aquí.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Libro de Reclamaciones (INDECOPI). Usa la misma RESEND_API_KEY de arriba.
# Correo que recibe las hojas de reclamación (si se deja vacío se usa CONTACT_TO_EMAIL).
COMPLAINTS_TO_EMAIL=
# Numeración correlativa y registro de las hojas (Redis). Usa UNA de estas dos opciones:
# a) Vercel → Storage → Redis (Redis Cloud): Vercel crea REDIS_URL solo.
REDIS_URL=
# b) Upstash (API REST): Vercel crea estas dos solas al conectar Upstash.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Sin Redis el número es único pero NO correlativo (no cumple al 100 % con INDECOPI).
