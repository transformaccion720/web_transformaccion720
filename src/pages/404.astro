---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSite } from '@/lib/content';

const site = await getSite();
const nf = site.notFound;
---

<BaseLayout title={`${nf.title} • ${site.brandName}`} description={nf.text || nf.title} noindex>
  <section class="hero-aurora text-white">
    <div class="tech-grid-overlay pointer-events-none absolute inset-0"></div>
    <div class="relative z-10 mx-auto max-w-2xl px-4 py-28 text-center">
      {nf.kicker && (
        <p class="text-xs font-extrabold tracking-[0.22em] text-amber-300 uppercase">{nf.kicker}</p>
      )}
      <h1 class="mt-3 font-display text-4xl font-black tracking-tight lg:text-5xl">{nf.title}</h1>
      {nf.text && <p class="mt-4 text-slate-300">{nf.text}</p>}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="rounded-full bg-brand-orange px-7 py-3.5 text-sm font-extrabold text-brand-deep transition hover:bg-amber-400"
        >
          {nf.primary}
        </a>
        {nf.secondary && (
          <a
            href={nf.secondaryHref || '/conversemos'}
            class="rounded-full border border-white/20 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-white/20"
          >
            {nf.secondary}
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
