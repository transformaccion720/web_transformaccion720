---
/**
 * Artículo /blog/<slug> con formato editorial (como Web_Personal_GT): migas, título, bajada, autor,
 * portada grande, índice + compartir (laterales fijos), barra de lectura, etiquetas, llamado final y relacionados.
 * Los atributos data-article* alimentan el lector en ventana de /blog.
 */
import { shareImage } from '@/lib/images';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { ArrowLeft, Link2 } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import {
  categoryName,
  getBlogCategories,
  getBlogSettings,
  getPosts,
  getSite,
  newsDate,
  readLabel,
  formatDate,
  type Post,
} from '@/lib/content';
import { contactHref } from '@/lib/actions';
import { initials } from '@/lib/format';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const [site, texts, categories] = await Promise.all([getSite(), getBlogSettings(), getBlogCategories()]);
const { Content, headings } = await render(post);
const d = post.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const siteUrl = Astro.site!.toString();
const url = new URL(`/blog/${post.id}`, siteUrl).toString();
const share = encodeURIComponent(url);
const ogImage = await shareImage(d.cover);
const cat = categoryName(categories, d.category);
const related = [
  ...posts.filter((p) => p.id !== post.id && p.data.category === d.category),
  ...posts.filter((p) => p.id !== post.id && p.data.category !== d.category),
].slice(0, 3);

const schema = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.excerpt,
    datePublished: d.publishedAt.toISOString(),
    author: d.author ? { '@type': 'Person', name: d.author } : { '@id': `${siteUrl}#organization` },
    publisher: { '@id': `${siteUrl}#organization` },
    mainEntityOfPage: url,
    articleSection: cat,
    keywords: d.tags.join(', '),
    inLanguage: 'es-PE',
    ...(ogImage && { image: new URL(ogImage, siteUrl).toString() }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: texts.title, item: new URL('/blog', siteUrl).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
const shareBtn =
  'flex size-9 items-center justify-center rounded-full border border-slate-200 bg-white transition hover:-translate-y-0.5 dark:border-slate-700 dark:bg-slate-800';
---

<BaseLayout
  title={`${d.title} • ${site.brandName}`}
  description={d.excerpt}
  image={ogImage}
  type="article"
  schema={schema}
>
  <div class="fixed inset-x-0 top-0 z-[70] h-[3px]" aria-hidden="true">
    <div data-progress class="h-full w-0 bg-gradient-to-r from-brand-cyan to-brand-orange"></div>
  </div>

  <article
    class="bg-brand-cream dark:bg-slate-950"
    data-article
    data-title={d.title}
    data-cat={cat}
    data-date={newsDate(d.publishedAt)}
    data-read={readLabel(post)}
    data-author={d.author}
  >
    <header class="mx-auto max-w-3xl px-4 pt-10 lg:pt-12">
      <nav
        aria-label="Migas de pan"
        class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400"
      >
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-semibold text-slate-600 hover:text-brand-teal dark:text-slate-300"
        >
          <ArrowLeft size={14} aria-hidden="true" /> {texts.backToList}
        </a>
        <span>/</span>
        <span>{cat}</span>
      </nav>
      <p class="mt-6 text-[11px] font-extrabold tracking-[0.14em] text-brand-teal uppercase dark:text-cyan-400">
        {cat} - {readLabel(post)} -{' '}
        <time datetime={d.publishedAt.toISOString()}>{formatDate(d.publishedAt)}</time>
      </p>
      <h1
        class="mt-3 font-display text-[32px] leading-[1.1] font-black text-brand-navy lg:text-[44px] dark:text-white"
        data-cms="posts.title"
      >
        {d.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600 italic dark:text-slate-300">{d.excerpt}</p>
      {d.author && (
        <div class="mt-6 flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-full bg-brand-navy font-display text-xs font-black text-brand-orange">
            {initials(d.author)}
          </span>
          <div class="text-[13px] leading-tight">
            <p class="font-bold text-brand-navy dark:text-white" data-cms="posts.author">
              {d.author}
            </p>
            <p class="text-slate-600 dark:text-slate-400">{texts.authorRole}</p>
          </div>
        </div>
      )}
    </header>

    {d.cover && (
      <div class="mx-auto mt-8 max-w-5xl px-4">
        <Image
          src={d.cover}
          alt={d.coverAlt || d.title}
          widths={[800, 1200, 1600]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/9] w-full rounded-[28px] object-cover shadow-apple-lg"
          data-article-cover
          data-cms="posts.cover"
        />
      </div>
    )}

    <div class="mx-auto grid max-w-5xl gap-10 px-4 py-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:py-12">
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-4">
          {toc.length > 1 && (
            <nav
              aria-label={texts.tocTitle}
              class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900"
            >
              <p class="text-[10px] font-extrabold tracking-[0.2em] text-slate-500 dark:text-slate-400 uppercase">
                {texts.tocTitle}
              </p>
              <ol class="mt-3 space-y-2">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc={h.slug}
                      class="toc-link block text-[12.5px] leading-snug text-slate-600 hover:text-brand-teal dark:text-slate-400"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
            <p class="text-[10px] font-extrabold tracking-[0.2em] text-slate-500 dark:text-slate-400 uppercase">
              {texts.shareTitle}
            </p>
            <div class="mt-3 flex gap-2">
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Compartir en LinkedIn"
                class={shareBtn}
              >
                <BrandIcon name="linkedin" size={16} />
              </a>
              <a
                href={`https://wa.me/?text=${encodeURIComponent(d.title + ' ')}${share}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Compartir por WhatsApp"
                class={shareBtn}
              >
                <BrandIcon name="whatsapp" size={16} />
              </a>
              <button
                type="button"
                data-copy={url}
                data-copied={texts.copiedToast}
                aria-label={texts.copyText}
                class={shareBtn}
              >
                <Link2 size={16} className="text-brand-navy dark:text-white" />
              </button>
            </div>
          </div>
        </div>
      </aside>

      <div>
        {d.keyTakeaways.length > 0 && (
          <aside class="mb-8 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <h2 class="mb-3 text-xs font-extrabold tracking-widest text-brand-teal uppercase dark:text-cyan-400">
              {texts.takeawaysTitle}
            </h2>
            <ul class="list-disc space-y-1.5 pl-5 text-sm text-slate-700 dark:text-slate-300">
              {d.keyTakeaways.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          </aside>
        )}

        <div class="post-prose" data-article-body>
          <Content />
        </div>

        {d.quote && (
          <blockquote
            class="my-8 border-l-4 border-brand-orange pl-5 font-display text-lg font-bold text-brand-navy italic dark:text-white"
            data-cms="posts.quote"
          >
            {d.quote}
          </blockquote>
        )}

        {d.tags.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2 border-t border-slate-200 pt-5 dark:border-slate-800">
            {d.tags.map((t) => (
              <li class="rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                #{t}
              </li>
            ))}
          </ul>
        )}

        <div class="mt-8 flex flex-col items-start gap-4 rounded-[24px] bg-[#0B1F3A] p-6 text-white shadow-apple-lg sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-display text-xl font-extrabold">{texts.articleCtaTitle}</p>
            <p class="mt-1 text-[13.5px] text-slate-300">{texts.articleCtaText}</p>
          </div>
          <a
            href={contactHref(texts.ctaService)}
            class="shrink-0 rounded-full bg-brand-orange px-6 py-3 text-sm font-extrabold text-brand-deep transition hover:-translate-y-0.5 hover:bg-amber-400"
          >
            {texts.articleCtaButton}
          </a>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="border-t border-slate-200 bg-white py-12 dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto max-w-5xl px-4">
        <h2 class="font-display text-2xl font-extrabold text-brand-navy dark:text-white">
          {texts.relatedTitle}
        </h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-3">
          {related.map((p) => (
            <li>
              <a
                href={`/blog/${p.id}`}
                class="group block overflow-hidden rounded-[20px] border border-slate-200 bg-brand-cream/60 transition hover:-translate-y-1 hover:bg-white dark:border-slate-800 dark:bg-slate-950"
              >
                {p.data.cover && (
                  <Image
                    src={p.data.cover}
                    alt={p.data.coverAlt || p.data.title}
                    widths={[400, 640]}
                    sizes="(min-width: 640px) 33vw, 100vw"
                    class="aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-[1.04]"
                  />
                )}
                <div class="p-4">
                  <p class="text-[10px] font-extrabold tracking-[0.12em] text-brand-teal uppercase dark:text-cyan-400">
                    {categoryName(categories, p.data.category)}
                  </p>
                  <h3 class="mt-1.5 font-display text-base leading-snug font-bold text-brand-navy dark:text-white">
                    {p.data.title}
                  </h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { showToast } from '@/lib/toast';
  import { track } from '@/lib/track';

  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const prose = document.querySelector<HTMLElement>('.post-prose');
  const onScroll = () => {
    if (!prose || !bar) return;
    const r = prose.getBoundingClientRect();
    bar.style.width = `${Math.min(100, Math.max(0, ((innerHeight - r.top) / r.height) * 100))}%`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a])
  );
  if (links.size) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.classList.remove('is-on'));
          links.get(e.target.id)?.classList.add('is-on');
        }),
      { rootMargin: '-20% 0px -70% 0px' }
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }

  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? location.href);
    } catch {
      /* sin permiso */
    }
    showToast(btn.dataset.copied || '');
    track('compartir', { red: 'copiar_enlace' });
  });
</script>

<style>
  .toc-link:global(.is-on) {
    color: var(--color-brand-teal);
    font-weight: 700;
  }
  .post-prose {
    color: #334155;
    font-size: 16.5px;
    line-height: 1.8;
  }
  :global(.dark) .post-prose {
    color: #cbd5e1;
  }
  .post-prose :global(> * + *) {
    margin-top: 1.15rem;
  }
  .post-prose :global(h2),
  .post-prose :global(h3) {
    margin-top: 2.2rem;
    scroll-margin-top: 6rem;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-brand-navy);
  }
  .post-prose :global(h2) {
    font-size: 1.55rem;
  }
  .post-prose :global(h3) {
    font-size: 1.2rem;
  }
  :global(.dark) .post-prose :global(h2),
  :global(.dark) .post-prose :global(h3),
  :global(.dark) .post-prose :global(strong) {
    color: #fff;
  }
  .post-prose :global(ul),
  .post-prose :global(ol) {
    padding-left: 1.3rem;
  }
  .post-prose :global(ul) {
    list-style: disc;
  }
  .post-prose :global(ol) {
    list-style: decimal;
  }
  .post-prose :global(li + li) {
    margin-top: 0.45rem;
  }
  .post-prose :global(li::marker) {
    color: var(--color-brand-teal);
  }
  .post-prose :global(strong) {
    color: var(--color-brand-navy);
    font-weight: 700;
  }
  .post-prose :global(a) {
    color: var(--color-brand-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-prose :global(blockquote) {
    border-left: 3px solid var(--color-brand-orange);
    padding-left: 1.1rem;
    font-style: italic;
    font-size: 1.1rem;
  }
  .post-prose :global(img) {
    border-radius: 1.25rem;
  }
</style>
