---
/**
 * Ventana de video sutil estilo Apple (una sola para toda la web).
 * Cualquier elemento con data-video="enlace de YouTube" la abre; data-video-title pone el título.
 */
---

<div
  id="video-modal"
  data-modal
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="video-modal-title"
  class="ta-modal fixed inset-0 z-[60] flex items-center justify-center bg-slate-950/35 p-4 backdrop-blur-md"
>
  <div class="w-full max-w-3xl overflow-hidden rounded-3xl border border-white/15 bg-[#0B1F3A]/95 shadow-apple-lg">
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-3.5">
      <div class="flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-brand-orange"></span>
        <h3 id="video-modal-title" class="font-display text-sm font-bold text-white">
          Video TransformAcción720
        </h3>
      </div>
      <button
        type="button"
        data-modal-close
        class="flex size-8 items-center justify-center rounded-full bg-white/10 text-sm text-white transition hover:bg-white/20"
        aria-label="Cerrar video"
      >
        ✕
      </button>
    </div>
    <div class="aspect-video bg-black">
      <iframe
        id="video-modal-frame"
        class="h-full w-full"
        title="Reproductor de video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>

<script>
  import { openModal } from '@/scripts/modal';
  import { youtubeEmbed, youtubeId } from '@/lib/video';

  const modal = document.getElementById('video-modal')!;
  const frame = document.getElementById('video-modal-frame') as HTMLIFrameElement;
  const title = document.getElementById('video-modal-title')!;

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-video]');
    if (!trigger) return;
    const url = trigger.dataset.video || '';
    const id = youtubeId(url);
    e.preventDefault();
    if (!id) {
      if (/^https?:/i.test(url)) window.open(url, '_blank', 'noopener');
      return;
    }
    frame.src = youtubeEmbed(id);
    title.textContent = trigger.dataset.videoTitle || 'Video TransformAcción720';
    openModal(modal, () => (frame.src = 'about:blank'));
  });
</script>
