---
/** Página completa del CMS: SEO + secciones. La usan / (portada) y /<slug> */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from './SectionRenderer.astro';
import { getSite, type Page } from '@/lib/content';

interface Props {
  page: Page;
  isHome?: boolean;
}

const { page, isHome = false } = Astro.props;
const site = await getSite();
const { data } = page;

const title = data.seoTitle || (isHome ? site.siteTitle : `${data.title} • ${site.brandName}`);
const description = data.seoDescription || site.siteDescription;

// Las preguntas frecuentes de la página se publican también como FAQPage para Google
const faqs = data.sections.flatMap((s) =>
  s.discriminant === 'faq' || s.discriminant === 'faqGrid' ? s.value.items : []
);
const schema = faqs.length
  ? [
      {
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      },
    ]
  : [];
---

<BaseLayout title={title} description={description} schema={schema}>
  {data.sections.length ? (
    <SectionRenderer sections={data.sections} />
  ) : (
    <section class="pt-40 pb-32 text-center">
      <h1 class="text-3xl font-bold">{data.title}</h1>
      <p class="mt-3 text-ink-soft">Esta página aún no tiene secciones. Añádelas desde el CMS.</p>
    </section>
  )}
</BaseLayout>
