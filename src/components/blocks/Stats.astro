---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'stats'>;
  path: string;
  first?: boolean;
}

const { data, path, first = false } = Astro.props;
---

<Section anchor={data.anchor} background={data.background} first={first}>
  <SectionHeading kicker={data.kicker} title={data.title} subtitle={data.subtitle} path={path} />
  <dl class="grid grid-cols-2 gap-8 text-center lg:grid-cols-4">
    {data.items.map((s, i) => (
      <div>
        <dt class="sr-only">{s.label}</dt>
        <dd
          class="font-display text-4xl font-extrabold tracking-tight lg:text-5xl"
          data-cms={`${path}.items.${i}.value`}
        >
          {s.value}
        </dd>
        <dd class="mt-2 text-sm text-ink-soft" aria-hidden="true" data-cms={`${path}.items.${i}.label`}>
          {s.label}
        </dd>
      </div>
    ))}
  </dl>
</Section>
