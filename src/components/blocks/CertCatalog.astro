---
/**
 * Catálogo de certificaciones (ej: Certiprof) en el Hub: encabezado con logo, filtro por categoría
 * (scripts/filters.ts) y tarjetas tipo credencial con la insignia oficial (o la sigla si aún no hay imagen).
 */
import { Image } from 'astro:assets';
import ActionButton from '@/components/ui/ActionButton.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'certCatalog'>;
  path: string;
}

const { data, path } = Astro.props;
const slug = (t: string) =>
  t
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-');
const categories = [...new Set(data.items.map((c) => c.category).filter(Boolean))];
const chip =
  'rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold text-slate-600 transition hover:border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 [&.active]:border-brand-navy [&.active]:bg-brand-navy [&.active]:text-white dark:[&.active]:border-brand-orange dark:[&.active]:bg-brand-orange dark:[&.active]:text-brand-deep';
---

<section id={data.anchor || undefined} class="bg-white py-14 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8" data-filter-scope>
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex items-center gap-5">
        {data.logo && (
          <div class="hidden shrink-0 rounded-2xl border border-slate-200 bg-white p-3 shadow-apple sm:block dark:border-slate-800">
            <Image src={data.logo} alt={data.logoAlt} height={56} class="h-14 w-auto" />
          </div>
        )}
        <div>
          {data.kicker && (
            <span class="kicker" data-cms={`${path}.kicker`}>
              {data.kicker}
            </span>
          )}
          <h2
            class="mt-1 font-display text-2xl font-extrabold text-brand-navy sm:text-3xl dark:text-white"
            data-cms={`${path}.title`}
          >
            {data.title}
          </h2>
          {data.text && (
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400" data-cms={`${path}.text`}>
              {data.text}
            </p>
          )}
        </div>
      </div>
      <ActionButton
        btn={data.button}
        cms={`${path}.button.text`}
        class="inline-flex shrink-0 items-center justify-center rounded-xl bg-brand-orange px-6 py-3 text-sm font-extrabold text-brand-deep transition hover:bg-amber-400"
      />
    </div>

    {categories.length > 1 && (
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar certificaciones">
        <button type="button" class:list={[chip, 'active']} data-filter="todos" aria-pressed="true">
          {data.allLabel}
        </button>
        {categories.map((c) => (
          <button type="button" class={chip} data-filter={slug(c)} aria-pressed="false">
            {c}
          </button>
        ))}
      </div>
    )}

    <ul class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
      {data.items.map((c, i) => (
        <li
          data-filter-item={slug(c.category)}
          class="group flex flex-col items-center rounded-3xl border border-slate-200/80 bg-brand-cream/60 p-5 text-center transition duration-300 hover:-translate-y-1 hover:border-brand-orange/40 hover:bg-white hover:shadow-apple dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="flex size-24 items-center justify-center">
            {c.image ? (
              <Image
                src={c.image}
                alt={c.name}
                width={192}
                class="size-24 object-contain transition duration-300 group-hover:scale-105"
              />
            ) : (
              <span class="flex size-20 items-center justify-center rounded-full bg-gradient-to-br from-brand-navy to-[#143f73] font-display text-xs font-black tracking-wide text-white ring-4 ring-brand-orange/30 transition duration-300 group-hover:scale-105">
                {c.code}
              </span>
            )}
          </div>
          <span class="mt-3 text-[10px] font-extrabold tracking-[0.14em] text-brand-orange uppercase">
            {c.category}
          </span>
          <h3
            class="mt-1 text-sm leading-snug font-bold text-brand-navy dark:text-white"
            data-cms={`${path}.items.${i}.name`}
          >
            {c.name}
          </h3>
          {c.meta && <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{c.meta}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
