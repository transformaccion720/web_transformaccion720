---
/** Equipo especialista: tarjetas 3D con foto, cargo en color y descripción */
import { Image } from 'astro:assets';
import { initials } from '@/lib/format';
import { tone } from '@/lib/tones';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'teamGrid'>;
  path: string;
}

const { data, path } = Astro.props;
---

{data.enabled && data.members.length > 0 && (
<section id={data.anchor || undefined} class="bg-white pt-14 pb-16 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      {data.kicker && <span class="kicker" data-cms={`${path}.kicker`}>{data.kicker}</span>}
      <h3 class="mt-1 font-display text-2xl font-extrabold text-brand-navy dark:text-white" data-cms={`${path}.title`}>{data.title}</h3>
    </div>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {data.members.map((m, i) => (
        <article class="card-3d rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          {m.photo ? (
            <Image src={m.photo} alt={m.name} width={128} height={128} class="mb-4 size-16 rounded-2xl object-cover" />
          ) : (
            <span class:list={['mb-4 flex size-16 items-center justify-center rounded-2xl font-display text-lg font-black', tone(m.tone).glass]}>{initials(m.name)}</span>
          )}
          <h4 class="font-display text-base font-bold text-brand-navy dark:text-white" data-cms={`${path}.members.${i}.name`}>{m.name}</h4>
          <div class:list={['mt-0.5 text-xs font-semibold', tone(m.tone).text]} data-cms={`${path}.members.${i}.role`}>{m.role}</div>
          <p class="mt-2.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400" data-cms={`${path}.members.${i}.bio`}>{m.bio}</p>
        </article>
      ))}
    </div>
  </div>
</section>
)}
