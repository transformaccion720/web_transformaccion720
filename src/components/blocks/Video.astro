---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { youtubeId, youtubeThumb } from '@/lib/video';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'video'>;
  path: string;
  first?: boolean;
}

const { data, path, first = false } = Astro.props;
const id = youtubeId(data.url);
---

<Section anchor={data.anchor} background={data.background} first={first} containerClass="max-w-4xl">
  <SectionHeading kicker={data.kicker} title={data.title} subtitle={data.subtitle} path={path} />
  {id && (
    // Fachada liviana: el reproductor de YouTube solo se carga al hacer clic
    <button
      type="button"
      class="yt-facade group relative block aspect-video w-full overflow-hidden rounded-[var(--radius-card)] bg-black"
      data-id={id}
      aria-label={`Reproducir video${data.title ? `: ${data.title}` : ''}`}
    >
      <img src={youtubeThumb(id)} alt="" loading="lazy" class="h-full w-full object-cover opacity-90" />
      <span class="absolute inset-0 m-auto flex size-20 items-center justify-center rounded-full bg-primary text-primary-ink shadow-xl transition group-hover:scale-110">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </button>
  )}
</Section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-facade').forEach((btn) =>
    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0`;
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = btn.getAttribute('aria-label') ?? 'Video';
        iframe.className = 'absolute inset-0 h-full w-full';
        btn.replaceChildren(iframe);
      },
      { once: true }
    )
  );
</script>
