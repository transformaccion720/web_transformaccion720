---
/** 1.6 Testimonios: se ven 3 a la vez; las flechas rotan de uno en uno (en bucle), como el mockup */
import Image from '@/components/ui/Img.astro';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'testimonialsCarousel'>;
  path: string;
}

const { data, path } = Astro.props;
const arrow =
  'flex size-10 items-center justify-center rounded-full border border-slate-200 bg-white text-brand-navy shadow-sm transition hover:bg-brand-orange hover:text-brand-deep dark:border-slate-700 dark:bg-slate-800 dark:text-white';
---

<section
  id={data.anchor || undefined}
  class="border-t border-slate-200/70 bg-brand-cream py-16 lg:py-20 dark:border-slate-800 dark:bg-slate-900/70"
  data-testimonials
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        {data.kicker && (
          <span
            class="text-xs font-extrabold tracking-[0.2em] text-slate-500 uppercase dark:text-slate-400"
            data-cms={`${path}.kicker`}
          >
            {data.kicker}
          </span>
        )}
        <h2
          class="mt-1 font-display text-2xl font-extrabold text-brand-navy sm:text-4xl dark:text-white"
          data-cms={`${path}.title`}
        >
          {data.title}
        </h2>
      </div>
      {data.items.length > 3 && (
        <div class="flex items-center gap-2">
          <button type="button" class={arrow} data-shift="-1" aria-label="Testimonio anterior">
            <ChevronLeft size={16} aria-hidden="true" />
          </button>
          <button type="button" class={arrow} data-shift="1" aria-label="Siguiente testimonio">
            <ChevronRight size={16} aria-hidden="true" />
          </button>
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3" aria-live="polite">
      {data.items.map((t, i) => (
        <figure
          class="flex items-start gap-4 rounded-3xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
          data-testimonial={i}
          hidden={i > 2}
        >
          {t.avatar && (
            <Image
              src={t.avatar}
              alt={t.name}
              width={112}
              height={112}
              class="size-14 shrink-0 rounded-full object-cover ring-2 ring-slate-100 dark:ring-slate-700"
            />
          )}
          <div class="flex h-full flex-col justify-between">
            <blockquote
              class="text-xs leading-relaxed text-slate-600 sm:text-[13px] dark:text-slate-300"
              data-cms={`${path}.items.${i}.quote`}
            >
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-4">
              <div
                class="font-display text-sm font-bold text-brand-navy dark:text-white"
                data-cms={`${path}.items.${i}.name`}
              >
                {t.name}
              </div>
              <div
                class="text-[11px] text-slate-500 dark:text-slate-400"
                data-cms={`${path}.items.${i}.role`}
              >
                {t.role}
              </div>
            </figcaption>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-testimonials]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-testimonial]')];
    let start = 0;
    const render = () =>
      cards.forEach((c, i) => {
        const pos = (i - start + cards.length) % cards.length;
        c.hidden = pos > 2;
        c.style.order = String(pos);
      });
    // Transición elegante: salida suave hacia el lado, cambio de tarjetas y entrada escalonada
    let busy = false;
    root.querySelectorAll<HTMLElement>('[data-shift]').forEach((b) =>
      b.addEventListener('click', () => {
        if (busy) return;
        busy = true;
        const dir = Number(b.dataset.shift);
        const visible = () => cards.filter((c) => !c.hidden);
        visible().forEach((c, k) => {
          c.style.transition = `opacity .5s ease ${k * 60}ms, transform .5s cubic-bezier(.22,1,.36,1) ${k * 60}ms`;
          c.style.opacity = '0';
          c.style.transform = `translateX(${dir * -24}px)`;
        });
        setTimeout(() => {
          start = (start + dir + cards.length) % cards.length;
          render();
          const now = [...visible()].sort((a, c) => Number(a.style.order) - Number(c.style.order));
          now.forEach((c) => {
            c.style.transition = 'none';
            c.style.opacity = '0';
            c.style.transform = `translateX(${dir * 24}px)`;
          });
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              now.forEach((c, k) => {
                c.style.transition = `opacity .7s ease ${k * 110}ms, transform .8s cubic-bezier(.22,1,.36,1) ${k * 110}ms`;
                c.style.opacity = '1';
                c.style.transform = 'none';
              });
              setTimeout(() => (busy = false), 900);
            })
          );
        }, 560);
      })
    );
  });
</script>
