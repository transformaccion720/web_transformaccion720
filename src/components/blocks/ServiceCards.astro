---
/** 1.3 Resumen de servicios: 3 tarjetas 3D con imagen e ícono; cada una lleva a su pestaña en /servicios */
import Image from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import Highlight from '@/components/ui/Highlight.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'serviceCards'>;
  path: string;
}

const { data, path } = Astro.props;
---

<section id={data.anchor || undefined} class="bg-white pt-12 pb-6 lg:pt-14 lg:pb-8 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        {data.kicker && (
          <span class="kicker" data-cms={`${path}.kicker`}>
            {data.kicker}
          </span>
        )}
        <h2 class="mt-1 font-display text-2xl leading-tight font-extrabold text-brand-navy sm:text-4xl dark:text-white">
          <Highlight text={data.title} markClass="text-brand-teal dark:text-cyan-400" />
        </h2>
      </div>
      {data.linkText && (
        <a
          href={data.linkHref || '/servicios'}
          class="text-sm font-bold whitespace-nowrap text-brand-navy transition hover:text-brand-orange dark:text-slate-200"
          data-cms={`${path}.linkText`}
        >
          {data.linkText}
        </a>
      )}
    </div>

    <div class="grid grid-cols-1 gap-7 md:grid-cols-3">
      {data.cards.map((c, i) => (
        <a
          href={c.href || '/servicios'}
          class="card-3d flex flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-apple dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="relative h-56 overflow-hidden">
            {c.image && (
              <Image
                src={c.image}
                alt={c.imageAlt}
                widths={[420, 680, 900]}
                sizes="(min-width: 1280px) 400px, (min-width: 768px) 33vw, calc(100vw - 2rem)"
                class="h-full w-full object-cover"
                data-cms={`${path}.cards.${i}.image`}
              />
            )}
            <div class="absolute top-4 left-4 flex size-11 items-center justify-center rounded-2xl border border-white/20 bg-slate-900/60 text-white backdrop-blur-md">
              <Icon name={c.icon} size={20} />
            </div>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3
              class="font-display text-xl font-extrabold text-brand-navy dark:text-white"
              data-cms={`${path}.cards.${i}.title`}
            >
              {c.title}
            </h3>
            <p
              class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400"
              data-cms={`${path}.cards.${i}.desc`}
            >
              {c.desc}
            </p>
            {c.linkText && (
              <div class="mt-5 text-sm font-bold text-brand-teal dark:text-cyan-400">{c.linkText}</div>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
