---
/** Hub 4.4 Ecosistema TA720: comunidad privada (estilo Skool) con tarjeta lateral de cifras y botón */
import Image from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'ecosystem'>;
  path: string;
}

const { data, path } = Astro.props;
// La primera cifra se destaca como sesión en vivo; el resto, como beneficios
const [live, ...perks] = data.stats;
const external = /^https?:/.test(data.buttonHref);
---

<section id={data.anchor || undefined} class="bg-brand-cream py-14 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
      <div class="space-y-6 rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-9 lg:col-span-8 dark:border-slate-800 dark:bg-slate-900">
        {data.image && (
          <div class="h-56 overflow-hidden rounded-2xl">
            <Image
              src={data.image}
              alt={data.imageAlt}
              widths={[640, 1000]}
              sizes="(min-width: 1024px) 700px, 100vw"
              class="h-full w-full object-cover"
            />
          </div>
        )}
        <div>
          {data.badge && (
            <span
              class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-extrabold text-emerald-700 uppercase dark:bg-emerald-900/30 dark:text-emerald-300"
              data-cms={`${path}.badge`}
            >
              {data.badge}
            </span>
          )}
          <h2
            class="mt-2 font-display text-2xl font-black text-brand-navy sm:text-3xl dark:text-white"
            data-cms={`${path}.title`}
          >
            {data.title}
          </h2>
          {data.text && (
            <p
              class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300"
              data-cms={`${path}.text`}
            >
              {data.text}
            </p>
          )}
        </div>
        {data.features.length > 0 && (
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {data.features.map((f, i) => (
              <li class="group flex items-center gap-3 rounded-xl border border-slate-200/70 bg-slate-50/80 p-3 transition hover:border-brand-teal/40 hover:bg-white dark:border-slate-800 dark:bg-slate-800/60">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-brand-navy to-[#143f73] text-white shadow-sm transition group-hover:from-brand-teal group-hover:to-emerald-500">
                  <Icon name={f.icon} size={17} />
                </span>
                <span
                  class="text-[13px] leading-snug font-semibold text-slate-700 dark:text-slate-200"
                  data-cms={`${path}.features.${i}.text`}
                >
                  {f.text}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="space-y-5 rounded-3xl border border-slate-200 bg-white p-6 shadow-apple lg:col-span-4 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center gap-3">
          <div class="flex size-12 items-center justify-center rounded-2xl bg-brand-navy font-display font-black text-brand-orange">
            {data.cardLogo}
          </div>
          <div>
            <div
              class="font-display text-base font-extrabold text-brand-navy dark:text-white"
              data-cms={`${path}.cardTitle`}
            >
              {data.cardTitle}
            </div>
            <div class="text-xs text-slate-600 dark:text-slate-400" data-cms={`${path}.cardSubtitle`}>
              {data.cardSubtitle}
            </div>
          </div>
        </div>
        {live && (
          <div class="flex items-center gap-3 rounded-2xl bg-gradient-to-r from-[#0B1F3A] to-[#143f73] p-4 text-white">
            <span class="relative flex size-3 shrink-0">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex size-3 rounded-full bg-red-500"></span>
            </span>
            <div class="leading-tight">
              <div class="font-display text-lg font-black">{live.value}</div>
              <div class="text-xs font-semibold text-slate-200">{live.label}</div>
            </div>
            <span class="ml-auto rounded-full bg-red-500 px-2.5 py-0.5 text-[10px] font-black tracking-wider uppercase">
              En vivo
            </span>
          </div>
        )}
        {perks.length > 0 && (
          <div class="grid grid-cols-2 gap-2">
            {perks.map((s) => (
              <div class="rounded-xl border border-slate-200/80 bg-slate-50 px-3 py-2.5 dark:border-slate-700 dark:bg-slate-800">
                <div class="font-display text-sm font-black text-brand-navy dark:text-white">{s.value}</div>
                <div class="text-[11px] leading-tight text-slate-600 dark:text-slate-400">{s.label}</div>
              </div>
            ))}
          </div>
        )}
        {data.cardHook && (
          <p
            class="text-center text-sm font-semibold text-brand-navy dark:text-white"
            data-cms={`${path}.cardHook`}
          >
            {data.cardHook}
          </p>
        )}
        {data.buttonText && (
          <a
            href={data.buttonHref || '#'}
            {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
            class="block w-full rounded-xl bg-brand-orange py-3.5 text-center text-sm font-extrabold text-brand-deep transition hover:bg-amber-400"
          >
            {data.buttonText}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
