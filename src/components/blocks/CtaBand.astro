---
/**
 * Banda de llamado a la acción a todo el ancho, horizontal y dinámica.
 * navy = pie de servicios / equipo / casos (degradado vivo, ícono, botón que late).
 * impact = portada (tarjeta de vidrio con borde luminoso dentro de la banda, más protagonista).
 */
import ActionButton from '@/components/ui/ActionButton.astro';
import Icon from '@/components/ui/Icon.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'ctaBand'>;
  path: string;
}

const { data, path } = Astro.props;
const impact = data.style === 'impact';
const [first, second] = data.buttons;
const primary =
  'cta-primary group relative inline-flex items-center gap-2 rounded-full bg-brand-orange px-7 py-3.5 text-sm font-extrabold tracking-wide text-brand-deep shadow-glow transition hover:-translate-y-0.5 hover:bg-amber-400';
const secondaryCls =
  'inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-6 py-3.5 text-sm font-bold text-white backdrop-blur-md transition hover:-translate-y-0.5 hover:bg-white/20';
---

<section id={data.anchor || undefined} class:list={['cta-band relative w-full overflow-hidden text-white', impact ? 'py-10' : 'py-8']}>
  <span class="cta-orb cta-orb-a" aria-hidden="true"></span>
  <span class="cta-orb cta-orb-b" aria-hidden="true"></span>
  <svg class="pointer-events-none absolute top-1/2 right-[-80px] h-[420px] w-[420px] -translate-y-1/2 opacity-20" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="40" fill="none" stroke="#fff" stroke-width=".6"></circle>
    <circle cx="100" cy="100" r="65" fill="none" stroke="#fff" stroke-width=".5"></circle>
    <circle cx="100" cy="100" r="90" fill="none" stroke="#fff" stroke-width=".4"></circle>
  </svg>

  <div class="relative mx-auto max-w-[88rem] px-4 sm:px-6 lg:px-10">
    <div
      class:list={[
        'flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center lg:gap-10',
        impact && 'cta-glass rounded-3xl border border-white/15 bg-white/[0.06] px-7 py-6 backdrop-blur-xl sm:px-10',
      ]}
    >
      <div class="flex min-w-0 flex-1 items-center gap-5">
        {data.icon !== 'none' && (
          <span class="cta-icon hidden size-14 shrink-0 items-center justify-center rounded-2xl border border-white/20 bg-white/10 text-brand-orange shadow-lg backdrop-blur-md sm:flex">
            <Icon name={data.icon} size={26} />
          </span>
        )}
        <div class="min-w-0 flex-1">
          {data.kicker && (
            <span class="mb-2 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[11px] font-extrabold tracking-[0.16em] text-amber-300 uppercase" data-cms={`${path}.kicker`}>
              <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
              {data.kicker}
            </span>
          )}
          <h3 class:list={['font-display font-extrabold tracking-tight xl:whitespace-nowrap', impact ? 'text-xl lg:text-[1.375rem]' : 'text-lg sm:text-xl']} data-cms={`${path}.title`}>
            {data.title}
          </h3>
          {data.text && <p class="mt-1 text-sm text-slate-200/90" data-cms={`${path}.text`}>{data.text}</p>}
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-3 lg:flex-nowrap">
        {first && (
          <ActionButton btn={first} cms={`${path}.buttons.0.text`} class={primary}>
            <span class="cta-arrow transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">🚀</span>
          </ActionButton>
        )}
        {second && <ActionButton btn={second} cms={`${path}.buttons.1.text`} class={secondaryCls} />}
      </div>
    </div>
  </div>
</section>
