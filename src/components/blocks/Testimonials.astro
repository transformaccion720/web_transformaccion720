---
import Image from '@/components/ui/Img.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'testimonials'>;
  path: string;
  first?: boolean;
}

const { data, path, first = false } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
---

<Section anchor={data.anchor} background={data.background} first={first}>
  <SectionHeading kicker={data.kicker} title={data.title} subtitle={data.subtitle} path={path} />
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {data.items.map((t, i) => (
      <li class="flex flex-col rounded-[var(--radius-card)] border border-line p-6">
        <blockquote class="flex-1 leading-relaxed" data-cms={`${path}.items.${i}.quote`}>
          “{t.quote}”
        </blockquote>
        <div class="mt-6 flex items-center gap-3">
          {t.avatar ? (
            <Image src={t.avatar} alt="" width={96} height={96} class="size-12 rounded-full object-cover" />
          ) : (
            <span class="flex size-12 items-center justify-center rounded-full bg-primary/10 font-semibold text-primary">
              {initials(t.name)}
            </span>
          )}
          <div>
            <p class="font-semibold" data-cms={`${path}.items.${i}.name`}>
              {t.name}
            </p>
            {t.role && (
              <p class="text-sm text-ink-soft" data-cms={`${path}.items.${i}.role`}>
                {t.role}
              </p>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
</Section>
