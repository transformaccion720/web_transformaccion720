---
/**
 * Guía IA (Ari): agente que acompaña la lectura. En escritorio va fijo a la izquierda y el contenido
 * guiado se corre a la derecha para darle espacio; en celular es una burbuja compacta abajo (se puede cerrar).
 * Cada bloque marcado con [data-guide-spot] dentro de la pestaña activa = un mensaje, en el mismo orden.
 */
import Image from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'aiGuide'>;
  path: string;
}

const { data, path } = Astro.props;
const ACCENTS = ['#F59E0B', '#2563EB', '#0D9488', '#7C3AED'];
// Paso dentro de su pestaña (1.º mensaje de "formacion" = 1.er bloque de esa pestaña)
const steps = new Map<string, number>();
const total = (tab: string) => data.messages.filter((m) => m.tab === tab).length;
const items = data.messages.map((m, i) => {
  const step = steps.get(m.tab) ?? 0;
  steps.set(m.tab, step + 1);
  return { ...m, i, step, total: total(m.tab), accent: ACCENTS[step % ACCENTS.length] };
});
---

{items.length > 0 && (
  <aside class="ari" data-ai-guide aria-label={`${data.title} - ${data.role}`} data-show="false">
    <button type="button" class="ari-close" data-ari-close aria-label="Cerrar guía">
      ×
    </button>
    <div class="ari-bot-wrap">
      <span class="ari-halo"></span>
      {data.image && (
        <Image src={data.image} alt={data.imageAlt} width={180} class="ari-bot" loading="lazy" />
      )}
    </div>
    <div class="ari-bubble" aria-live="polite">
      <div class="flex items-center gap-1.5 text-[11px]">
        <span class="font-display font-black text-brand-navy dark:text-white" data-cms={`${path}.title`}>
          {data.title}
        </span>
        <span class="text-slate-500 dark:text-slate-400" data-cms={`${path}.role`}>
          {data.role}
        </span>
        <span class="size-1.5 animate-pulse rounded-full bg-emerald-500"></span>
      </div>
      {items.map((m) => (
        <div data-guide-msg data-tab={m.tab} data-step={m.step} data-accent={m.accent} hidden class="ari-msg">
          <div class="mt-2 flex items-center gap-2">
            <span
              class="flex size-6 shrink-0 items-center justify-center rounded-lg text-white"
              style={`background:${m.accent}`}
            >
              <Icon name={m.icon} size={13} />
            </span>
            <span class="text-[10px] font-extrabold tracking-[0.14em] text-slate-500 uppercase dark:text-slate-400">
              <span data-cms={`${path}.messages.${m.i}.label`}>{m.label}</span>
              <span class="ml-1 text-slate-400 dark:text-slate-500">
                {m.step + 1}/{m.total}
              </span>
            </span>
          </div>
          <p
            class="mt-1.5 text-[13px] leading-relaxed text-slate-700 dark:text-slate-200"
            data-guide-text
            data-cms={`${path}.messages.${m.i}.text`}
          >
            {m.text}
          </p>
          {m.chips.length > 0 && (
            <div class="ari-chips mt-2 flex-wrap gap-1">
              {m.chips.map((c) => (
                <span class="rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {c}
                </span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </aside>
)}

<style is:global>
  /* Celular / tablet: burbuja compacta abajo, sobre el botón de tema */
  .ari {
    position: fixed;
    z-index: 30;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 5rem;
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .ari[data-show='false'] {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }
  .ari-bot-wrap {
    position: relative;
    flex-shrink: 0;
    width: 3.75rem;
    /* El personaje mira y señala hacia el contenido (derecha) */
    transform: scaleX(-1);
  }
  .ari-bot {
    position: relative;
    width: 100%;
    height: auto;
    animation: ari-float 4.5s ease-in-out infinite;
    filter: drop-shadow(0 10px 14px rgb(11 31 58 / 0.22));
  }
  .ari-bot.hop {
    animation:
      ari-hop 0.6s ease-out,
      ari-float 4.5s ease-in-out 0.6s infinite;
  }
  .ari-halo {
    position: absolute;
    inset: 15%;
    border-radius: 9999px;
    filter: blur(18px);
    background: var(--ari-accent, #f59e0b);
    opacity: 0.35;
    transition: background 0.7s ease;
  }
  .ari-bubble {
    position: relative;
    flex: 1;
    max-width: 22rem;
    border-radius: 1.1rem 1.1rem 1.1rem 0.35rem;
    border: 1px solid rgb(226 232 240 / 0.9);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(14px);
    padding: 0.7rem 0.9rem;
    box-shadow: 0 18px 40px -18px rgb(11 31 58 / 0.35);
  }
  .dark .ari-bubble {
    border-color: rgb(51 65 85);
    background: rgb(15 23 42 / 0.92);
  }
  .ari-chips {
    display: none;
  }
  .ari-msg [data-guide-text] {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ari-msg:not([hidden]) {
    animation: ari-in 0.45s ease-out;
  }
  .ari-close {
    position: absolute;
    right: -0.25rem;
    top: -0.6rem;
    z-index: 1;
    display: flex;
    width: 1.4rem;
    height: 1.4rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #0b1f3a;
    color: #fff;
    font-size: 0.9rem;
    line-height: 1;
  }

  /* Escritorio: agente fijo a la izquierda; el contenido guiado se corre a la derecha */
  @media (min-width: 1280px) {
    .ari {
      left: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem));
      right: auto;
      top: 50%;
      bottom: auto;
      width: 12.5rem;
      flex-direction: column;
      align-items: stretch;
      transform: translateY(-50%);
    }
    .ari[data-show='false'] {
      transform: translate(-12px, -50%);
    }
    .ari-bot-wrap {
      width: 6.5rem;
      margin-left: 0.25rem;
    }
    .ari-bubble {
      border-radius: 0.35rem 1.1rem 1.1rem 1.1rem;
    }
    .ari-chips {
      display: flex;
    }
    .ari-msg [data-guide-text] {
      -webkit-line-clamp: unset;
    }
    .ari-close {
      display: none;
    }
    body:has([data-ai-guide]) [data-panel]:has([data-guide-spot]) > section > .max-w-7xl {
      padding-left: 15.5rem;
    }
  }

  @keyframes ari-float {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-6px) rotate(2deg);
    }
  }
  @keyframes ari-hop {
    40% {
      transform: translateY(-10px) scale(1.06) rotate(-6deg);
    }
  }
  @keyframes ari-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ari-bot,
    .ari-bot.hop,
    .ari-msg:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  // Ari cuenta el bloque que está al centro de la pantalla, dentro de la pestaña activa
  const root = document.querySelector<HTMLElement>('[data-ai-guide]');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const msgs = [...root.querySelectorAll<HTMLElement>('[data-guide-msg]')];
    const tabs = [...new Set(msgs.map((m) => m.dataset.tab!))];
    const bot = root.querySelector<HTMLElement>('.ari-bot');
    let closed = sessionStorage.getItem('ari-off') === '1' && !matchMedia('(min-width:1280px)').matches;
    let tab = '';
    let shown: HTMLElement | null = null;
    let timer = 0;
    const inView = new Set<Element>();

    const activeTab = () =>
      tabs.find((t) => document.querySelector(`[data-tab="${CSS.escape(t)}"].active`)) ?? tabs[0];
    const spotsOf = (t: string) => [
      ...document.querySelectorAll<HTMLElement>(`[data-panel~="${CSS.escape(t)}"] [data-guide-spot]`),
    ];

    const type = (el: HTMLElement) => {
      const full = el.dataset.full ?? (el.dataset.full = el.textContent!.trim());
      clearInterval(timer);
      if (reduce) return void (el.textContent = full);
      let n = 0;
      el.textContent = '';
      timer = window.setInterval(() => {
        n += 3;
        el.textContent = full.slice(0, n);
        if (n >= full.length) clearInterval(timer);
      }, 16);
    };

    const say = (spot: Element) => {
      const step = spotsOf(tab).indexOf(spot as HTMLElement);
      const msg = msgs.find((m) => m.dataset.tab === tab && Number(m.dataset.step) === step);
      if (!msg || msg === shown) return;
      shown = msg;
      msgs.forEach((m) => (m.hidden = m !== msg));
      root.style.setProperty('--ari-accent', msg.dataset.accent!);
      bot?.classList.remove('hop');
      void bot?.offsetWidth;
      bot?.classList.add('hop');
      const text = msg.querySelector<HTMLElement>('[data-guide-text]');
      if (text) type(text);
    };

    const visible = () => {
      const on = !closed && spotsOf(tab).some((s) => inView.has(s));
      root.dataset.show = String(on);
    };

    // Banda central: decide qué bloque se está leyendo
    const center = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && say(e.target)),
      { rootMargin: '-45% 0px -45% 0px' }
    );
    // Toda la pantalla: muestra a Ari solo mientras hay bloques guiados a la vista
    const screen = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? inView.add(e.target) : inView.delete(e.target)));
      visible();
    });

    const setup = () => {
      const next = activeTab();
      if (next === tab) return;
      tab = next;
      shown = null;
      center.disconnect();
      screen.disconnect();
      inView.clear();
      const spots = spotsOf(tab);
      spots.forEach((s) => (center.observe(s), screen.observe(s)));
      if (spots[0]) say(spots[0]);
    };

    root.querySelector('[data-ari-close]')?.addEventListener('click', () => {
      closed = true;
      sessionStorage.setItem('ari-off', '1');
      visible();
    });
    document.addEventListener('tabs:change', setup);
    setup();
  }
</script>
