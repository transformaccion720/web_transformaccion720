---
/**
 * Franja clara y compacta: título a la izquierda y 3-4 cifras en horizontal, cada una con su barra que se llena
 * y su número que cuenta al aparecer en pantalla. Sin fondo oscuro; se adapta a modo claro/oscuro.
 */
import { tone } from '@/lib/tones';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'costStrip'>;
  path: string;
}

const { data, path } = Astro.props;
const num = (v: string) => Number.parseFloat(v.replace(',', '.').replace(/[^\d.]/g, '')) || 0;
const BAR: Record<string, string> = {
  orange: 'from-amber-400 to-orange-500',
  blue: 'from-sky-400 to-blue-600',
  teal: 'from-teal-400 to-emerald-500',
  cyan: 'from-cyan-300 to-sky-500',
  emerald: 'from-emerald-400 to-teal-500',
  indigo: 'from-indigo-400 to-violet-500',
  navy: 'from-slate-500 to-slate-700',
};
---

<section id={data.anchor || undefined} class="bg-white pt-4 pb-12 dark:bg-slate-950" data-cost>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-gradient-to-br from-amber-50/70 via-white to-sky-50 p-6 shadow-apple sm:p-8 lg:p-9 dark:border-white/10 dark:from-slate-900 dark:via-slate-900 dark:to-slate-900/60">
      <span
        class="pointer-events-none absolute -top-24 -right-20 size-72 rounded-full bg-amber-200/40 blur-3xl dark:bg-amber-400/10"
        aria-hidden="true"
      ></span>
      <span
        class="pointer-events-none absolute -bottom-24 left-1/3 size-72 rounded-full bg-sky-200/40 blur-3xl dark:bg-sky-400/10"
        aria-hidden="true"
      ></span>

      <div class="relative grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          {data.kicker && (
            <span class="kicker" data-cms={`${path}.kicker`}>
              {data.kicker}
            </span>
          )}
          <h2
            class="mt-2 font-display text-xl leading-snug font-extrabold text-brand-navy sm:text-2xl dark:text-white"
            data-cms={`${path}.title`}
          >
            {data.title}
          </h2>
          {data.source && (
            <p class="mt-3 text-[11px] text-slate-500 dark:text-slate-400" data-cms={`${path}.source`}>
              {data.source}
            </p>
          )}
        </div>

        <dl class="grid grid-cols-2 gap-x-6 gap-y-7 lg:col-span-8 lg:grid-cols-4 lg:gap-x-0">
          {data.items.map((s, i) => (
            <div class:list={['lg:px-6', i > 0 && 'lg:border-l lg:border-slate-200 dark:lg:border-white/10']}>
              <dt
                class:list={[
                  'font-display text-4xl leading-none font-black tracking-tight',
                  tone(s.tone).text,
                ]}
              >
                <span
                  data-cost-num={num(s.value)}
                  data-cost-suffix={s.value.replace(/[\d.,]/g, '')}
                  data-cms={`${path}.items.${i}.value`}
                >
                  {s.value}
                </span>
              </dt>
              <div
                class="mt-3 h-1.5 overflow-hidden rounded-full bg-slate-200/80 dark:bg-white/10"
                aria-hidden="true"
              >
                <div
                  class:list={[
                    'h-full w-0 rounded-full bg-gradient-to-r transition-[width] duration-[1400ms] ease-out',
                    BAR[s.tone] ?? BAR.orange,
                  ]}
                  data-cost-bar={Math.min(100, num(s.value))}
                ></div>
              </div>
              <dd
                class="mt-3 text-xs leading-relaxed text-slate-600 dark:text-slate-300"
                data-cms={`${path}.items.${i}.label`}
              >
                {s.label}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  // Al entrar en pantalla: las barras se llenan y los números cuentan hasta su valor
  document.querySelectorAll<HTMLElement>('[data-cost]').forEach((root) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const run = () => {
      root
        .querySelectorAll<HTMLElement>('[data-cost-bar]')
        .forEach((b) => (b.style.width = `${b.dataset.costBar}%`));
      root.querySelectorAll<HTMLElement>('[data-cost-num]').forEach((n) => {
        const to = Number(n.dataset.costNum);
        const suffix = n.dataset.costSuffix || '';
        if (reduce || !to) return;
        const t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / 1400);
          n.textContent = `${Math.round(to * (1 - Math.pow(1 - k, 3)))}${suffix}`;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };
    if (reduce || !('IntersectionObserver' in window)) return run();
    const io = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) {
          io.disconnect();
          run();
        }
      },
      { threshold: 0.35 }
    );
    io.observe(root);
  });
</script>
