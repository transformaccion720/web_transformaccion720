---
/**
 * 2.1 Quiénes somos, en horizontal: franja de presentación (texto + cifras) y debajo los dos perfiles
 * como tarjetas anchas (foto a la izquierda, datos a la derecha). La foto no cambia de opacidad al pasar el cursor.
 */
import Image from '@/components/ui/Img.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import Rich from '@/components/ui/Rich.astro';
import { tone } from '@/lib/tones';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'founders'>;
  path: string;
}

const { data, path } = Astro.props;
const statColor = (t: string) => (t === 'navy' ? 'text-brand-navy dark:text-white' : tone(t).text);
---

<section id={data.anchor || undefined} class="bg-white pt-14 pb-16 lg:pb-20 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl space-y-6 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 rounded-3xl border border-slate-200/80 bg-brand-cream p-7 lg:grid-cols-12 lg:gap-10 lg:p-9 dark:border-slate-800 dark:bg-slate-900">
      <div class="lg:col-span-7">
        {data.kicker && (
          <span class="kicker" data-cms={`${path}.kicker`}>
            {data.kicker}
          </span>
        )}
        <h2
          class="mt-2 font-display text-2xl leading-tight font-black text-brand-navy sm:text-3xl dark:text-white"
          data-cms={`${path}.title`}
        >
          {data.title}
        </h2>
        {data.body && (
          <div class="mt-4 space-y-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            <Rich text={data.body} paragraphs />
          </div>
        )}
      </div>
      {data.stats.length > 0 && (
        <div class="grid grid-cols-3 gap-3 lg:col-span-5">
          {data.stats.map((s, i) => (
            <div class="rounded-2xl border border-slate-200/70 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <div
                class:list={['font-display text-2xl font-black', statColor(s.tone)]}
                data-cms={`${path}.stats.${i}.value`}
              >
                {s.value}
              </div>
              <div
                class="mt-0.5 text-[11px] leading-tight text-slate-500 dark:text-slate-400"
                data-cms={`${path}.stats.${i}.label`}
              >
                {s.label}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      {data.founders.map((f, i) => {
        const t = tone(f.tone);
        return (
          <article class="flex flex-col gap-5 rounded-3xl border border-slate-200/80 bg-slate-50 p-6 sm:flex-row sm:p-7 dark:border-slate-800 dark:bg-slate-900">
            <div class="relative shrink-0 sm:w-44 sm:self-stretch">
              <span
                class:list={['absolute -inset-1.5 rounded-[1.4rem] opacity-50 blur-md', t.solid]}
                aria-hidden="true"
              ></span>
              {f.photo && (
                <Image
                  src={f.photo}
                  alt={f.name}
                  width={360}
                  height={440}
                  loading="eager"
                  class="relative h-72 w-full rounded-2xl object-cover object-top shadow-lg ring-2 ring-white sm:h-full sm:min-h-64 dark:ring-slate-900"
                />
              )}
              <span
                class:list={[
                  'absolute -right-2 -bottom-2 flex size-7 items-center justify-center rounded-lg text-[11px] font-black shadow-md ring-2 ring-white dark:ring-slate-900',
                  t.solid,
                ]}
                aria-hidden="true"
              >
                ★
              </span>
            </div>

            <div class="flex min-w-0 flex-1 flex-col justify-between">
              <div>
                <span
                  class:list={['text-[10.5px] font-extrabold tracking-wider uppercase', t.text]}
                  data-cms={`${path}.founders.${i}.role`}
                >
                  {f.role}
                </span>
                <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-2">
                  <h3
                    class="font-display text-xl leading-tight font-extrabold text-brand-navy dark:text-white"
                    data-cms={`${path}.founders.${i}.name`}
                  >
                    {f.name}
                  </h3>
                  {f.linkedin && (
                    <a
                      href={f.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-full bg-[#0A66C2]/10 px-3 py-1 text-[11px] font-bold text-[#0A66C2] transition hover:bg-[#0A66C2] hover:text-white"
                    >
                      <BrandIcon name="linkedin" size={14} mono />
                      <span>LinkedIn</span>
                    </a>
                  )}
                </div>
                {f.bio && (
                  <p
                    class="mt-3 text-[13px] leading-relaxed text-slate-600 dark:text-slate-300"
                    data-cms={`${path}.founders.${i}.bio`}
                  >
                    {f.bio}
                  </p>
                )}
                {f.quote && (
                  <div
                    class="mt-3 rounded-xl border border-slate-200/70 bg-white p-3 text-xs text-slate-600 italic dark:border-slate-700/70 dark:bg-slate-800/70 dark:text-slate-300"
                    data-cms={`${path}.founders.${i}.quote`}
                  >
                    “{f.quote}”
                  </div>
                )}
              </div>
              {f.chips.length > 0 && (
                <div class="mt-4 grid grid-cols-2 gap-2 border-t border-slate-200/70 pt-4 xl:grid-cols-3 dark:border-slate-800">
                  {f.chips.map((c) => (
                    <span class="flex items-center justify-center rounded-xl border border-slate-200/80 bg-white px-2 py-1.5 text-center text-[11px] leading-tight font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                      {c}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
