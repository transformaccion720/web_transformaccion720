---
/** Planes de desarrollo web y sistemas (3 tarjetas; la destacada en azul marino con borde naranja) */
import ActionButton from '@/components/ui/ActionButton.astro';
import { tone } from '@/lib/tones';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'webPackages'>;
  path: string;
}

const { data, path } = Astro.props;
---

<section id={data.anchor || undefined} class="bg-white pt-10 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 text-center">
      {data.kicker && (
        <span
          class="text-xs font-extrabold tracking-[0.2em] text-brand-blue uppercase dark:text-blue-400"
          data-cms={`${path}.kicker`}
        >
          {data.kicker}
        </span>
      )}
      <h3
        class="mt-1 font-display text-2xl font-extrabold text-brand-navy sm:text-3xl dark:text-white"
        data-cms={`${path}.title`}
      >
        {data.title}
      </h3>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {data.plans.map((p, i) =>
        p.featured ? (
          <div class="relative flex flex-col rounded-3xl border-2 border-brand-orange bg-[#0B1F3A] p-7 text-white shadow-apple-lg">
            {p.ribbon && (
              <span class="absolute -top-3 right-6 rounded-full bg-brand-orange px-3 py-1 text-[10px] font-black text-brand-deep uppercase">
                {p.ribbon}
              </span>
            )}
            <span class="text-xs font-bold text-amber-300 uppercase">{p.tag}</span>
            <h4 class="mt-1 font-display text-xl font-extrabold" data-cms={`${path}.plans.${i}.title`}>
              {p.title}
            </h4>
            <p class="mt-2 text-xs text-slate-300" data-cms={`${path}.plans.${i}.desc`}>
              {p.desc}
            </p>
            <ul class="mt-5 flex-1 space-y-2 text-xs text-slate-200">
              {p.features.map((f) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <ActionButton
              btn={p.button}
              class="mt-6 block w-full rounded-xl bg-brand-orange py-3 text-center text-xs font-extrabold text-brand-deep transition hover:bg-amber-400"
            />
          </div>
        ) : (
          <div class="flex flex-col rounded-3xl border border-slate-200 bg-white p-7 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <span class:list={['text-xs font-bold uppercase', tone(p.tone).text]}>{p.tag}</span>
            <h4
              class="mt-1 font-display text-xl font-extrabold text-brand-navy dark:text-white"
              data-cms={`${path}.plans.${i}.title`}
            >
              {p.title}
            </h4>
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-400" data-cms={`${path}.plans.${i}.desc`}>
              {p.desc}
            </p>
            <ul class="mt-5 flex-1 space-y-2 text-xs text-slate-600 dark:text-slate-300">
              {p.features.map((f) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <ActionButton
              btn={p.button}
              class="mt-6 block w-full rounded-xl bg-slate-100 py-3 text-center text-xs font-bold transition hover:bg-brand-navy hover:text-white dark:bg-slate-800"
            />
          </div>
        )
      )}
    </div>
  </div>
</section>
