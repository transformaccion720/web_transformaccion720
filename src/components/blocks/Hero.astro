---
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import Buttons from './Buttons.astro';
import type { SectionOf } from '@/lib/content';

interface Props {
  data: SectionOf<'hero'>;
  path: string;
  first?: boolean;
}

const { data, path, first = false } = Astro.props;
const loading = first ? 'eager' : 'lazy';
const layout = data.image ? data.layout : 'centered';
const Title = first ? 'h1' : 'h2';
---

{layout === 'background' && data.image ? (
  <section id={data.anchor || undefined} class="relative isolate overflow-hidden bg-dark text-white">
    <Image
      src={data.image}
      alt={data.imageAlt}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading={loading}
      fetchpriority={first ? 'high' : 'auto'}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      data-cms={`${path}.image`}
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/75 via-black/50 to-black/20" />
    <Container class="flex min-h-[78vh] flex-col justify-center py-24">
      <div class="max-w-2xl">
        {data.kicker && (
          <p class="kicker !text-accent" data-cms={`${path}.kicker`}>
            {data.kicker}
          </p>
        )}
        <Title
          class="mt-3 font-display text-4xl font-extrabold tracking-tight text-balance lg:text-6xl"
          data-cms={`${path}.title`}
        >
          {data.title}
        </Title>
        {data.subtitle && (
          <p class="mt-5 text-lg text-white/80 lg:text-xl" data-cms={`${path}.subtitle`}>
            {data.subtitle}
          </p>
        )}
        <Buttons primary={data.primary} secondary={data.secondary} path={path} class="mt-8" />
      </div>
    </Container>
  </section>
) : layout === 'split' && data.image ? (
  <section id={data.anchor || undefined} class={`section-${data.background}`}>
    <Container class:list={["grid items-center gap-10 lg:grid-cols-2", first ? "pt-32 pb-16 lg:pt-36 lg:pb-24" : "py-16 lg:py-24"]}>
      <div>
        {data.kicker && (
          <p class="kicker" data-cms={`${path}.kicker`}>
            {data.kicker}
          </p>
        )}
        <Title
          class="mt-3 font-display text-4xl font-extrabold tracking-tight text-balance lg:text-5xl"
          data-cms={`${path}.title`}
        >
          {data.title}
        </Title>
        {data.subtitle && (
          <p class="mt-5 text-lg text-ink-soft" data-cms={`${path}.subtitle`}>
            {data.subtitle}
          </p>
        )}
        <Buttons primary={data.primary} secondary={data.secondary} path={path} class="mt-8" />
      </div>
      <Image
        src={data.image}
        alt={data.imageAlt}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading={loading}
        fetchpriority={first ? 'high' : 'auto'}
        class="aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover"
        data-cms={`${path}.image`}
      />
    </Container>
  </section>
) : (
  <section id={data.anchor || undefined} class={`section-${data.background}`}>
    <Container class:list={["text-center", first ? "pt-36 pb-20 lg:pb-28" : "py-20 lg:py-28"]}>
      <div class="mx-auto max-w-3xl">
        {data.kicker && (
          <p class="kicker" data-cms={`${path}.kicker`}>
            {data.kicker}
          </p>
        )}
        <Title
          class="mt-3 font-display text-4xl font-extrabold tracking-tight text-balance lg:text-6xl"
          data-cms={`${path}.title`}
        >
          {data.title}
        </Title>
        {data.subtitle && (
          <p class="mt-5 text-lg text-ink-soft lg:text-xl" data-cms={`${path}.subtitle`}>
            {data.subtitle}
          </p>
        )}
        <Buttons primary={data.primary} secondary={data.secondary} path={path} class="mt-8 justify-center" />
      </div>
    </Container>
  </section>
)}
