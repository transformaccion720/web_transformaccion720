---
/**
 * Conversemos: canales ejecutivos (izquierda) + formulario (derecha). Envía a /api/contact (Resend).
 * Si se llega desde un botón con servicio (/conversemos?servicio=…), se preselecciona y se escribe el mensaje.
 */
import { Lock } from 'lucide-react';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { getSite, type SectionOf } from '@/lib/content';
import { safeJson } from '@/lib/format';

interface Props {
  data: SectionOf<'contactPanel'>;
  path: string;
}

const { data, path } = Astro.props;
const site = await getSite();
const uid = `c-${Math.random().toString(36).slice(2, 7)}`;
const config = { prefill: data.prefill, success: data.successToast, error: data.errorText, sending: data.sendingText };
const label = 'mb-1.5 block text-xs font-bold text-slate-600 dark:text-slate-300';
const field = 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand-blue focus:outline-none';
---

<section id={data.anchor || undefined} class="bg-white pt-16 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-5">
        <div class="space-y-5 rounded-3xl border border-slate-200 bg-brand-cream p-7 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="font-display text-xl font-extrabold text-brand-navy dark:text-white" data-cms={`${path}.title`}>{data.title}</h2>
          <div class="space-y-4 text-sm">
            {site.whatsapp && (
              <div class="flex items-center gap-3.5">
                <span class="flex size-10 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-600"><BrandIcon name="whatsapp" size={18} mono /></span>
                <div>
                  <div class="text-xs text-slate-500">{data.whatsappLabel}</div>
                  <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="font-bold hover:text-brand-orange">{site.whatsappDisplay || `+${site.whatsapp}`}</a>
                </div>
              </div>
            )}
            {site.email && (
              <div class="flex items-center gap-3.5">
                <span class="flex size-10 items-center justify-center rounded-xl bg-blue-500/15 font-bold text-brand-blue">@</span>
                <div class="min-w-0">
                  <div class="text-xs text-slate-500">{data.emailLabel}</div>
                  <a href={`mailto:${site.email}`} class="block truncate font-bold hover:text-brand-orange">{site.email}</a>
                </div>
              </div>
            )}
            {data.address && (
              <div class="flex items-center gap-3.5">
                <span class="flex size-10 items-center justify-center rounded-xl bg-amber-500/15 font-bold text-brand-orange">{site.country}</span>
                <div>
                  <div class="text-xs text-slate-500">{data.addressLabel}</div>
                  <div class="font-bold" data-cms={`${path}.address`}>{data.address}</div>
                </div>
              </div>
            )}
          </div>
          {data.note && (
            <div class="flex items-center gap-2 border-t border-slate-200 pt-4 text-xs text-slate-500 dark:border-slate-800">
              <Lock size={14} aria-hidden="true" /> <span data-cms={`${path}.note`}>{data.note}</span>
            </div>
          )}
        </div>
      </div>

      <div id="formulario" class="rounded-3xl border border-slate-200 bg-white p-7 shadow-apple sm:p-9 lg:col-span-7 dark:border-slate-800 dark:bg-slate-900">
        <form class="space-y-4" data-contact-form>
          <input type="text" name="honeypot" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for={`${uid}-name`} class={label}>{data.nameLabel}</label>
              <input id={`${uid}-name`} name="name" required maxlength="120" autocomplete="name" placeholder={data.namePlaceholder} class={field} />
            </div>
            <div>
              <label for={`${uid}-company`} class={label}>{data.companyLabel}</label>
              <input id={`${uid}-company`} name="company" required maxlength="120" autocomplete="organization" placeholder={data.companyPlaceholder} class={field} />
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for={`${uid}-email`} class={label}>{data.emailFieldLabel}</label>
              <input id={`${uid}-email`} name="email" type="email" required maxlength="160" autocomplete="email" placeholder={data.emailPlaceholder} class={field} />
            </div>
            <div>
              <label for={`${uid}-phone`} class={label}>{data.phoneLabel}</label>
              <input id={`${uid}-phone`} name="phone" type="tel" required maxlength="40" autocomplete="tel" placeholder={data.phonePlaceholder} class={field} />
            </div>
          </div>
          {data.services.length > 0 && (
            <div>
              <label for={`${uid}-service`} class={label}>{data.serviceLabel}</label>
              <select id={`${uid}-service`} name="service" class={field} data-service>
                {data.services.map((s) => <option value={s.value || s.label}>{s.label || s.value}</option>)}
              </select>
            </div>
          )}
          <div>
            <label for={`${uid}-message`} class={label}>{data.messageLabel}</label>
            <textarea id={`${uid}-message`} name="message" rows="4" required maxlength="3000" placeholder={data.messagePlaceholder} class={field} data-message></textarea>
          </div>
          <button type="submit" class="w-full rounded-xl bg-brand-navy py-3.5 text-sm font-extrabold tracking-wide text-white shadow-sm transition hover:bg-brand-blue dark:bg-brand-blue dark:hover:bg-blue-500 disabled:opacity-60" data-submit>
            <span data-cms={`${path}.submitText`}>{data.submitText}</span>
          </button>
        </form>
      </div>
    </div>
  </div>
  <script type="application/json" data-contact-config set:html={safeJson(config)} />
</section>

<script>
  import { fill } from '@/lib/format';
  import { showToast } from '@/lib/toast';
  import { track } from '@/lib/track';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const section = form.closest('section')!;
    const cfg = JSON.parse(section.querySelector('[data-contact-config]')?.textContent || '{}') as {
      prefill: string;
      success: string;
      error: string;
      sending: string;
    };
    const select = form.querySelector<HTMLSelectElement>('[data-service]');
    const message = form.querySelector<HTMLTextAreaElement>('[data-message]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = button.querySelector('span')!;
    const idle = label.textContent;

    // Servicio preseleccionado desde otro botón de la web (como goToContactWithService del mockup)
    const service = new URLSearchParams(location.search).get('servicio')?.trim();
    if (service && select) {
      const match = [...select.options].find((o) => o.value === service || o.text === service);
      if (match) select.value = match.value;
      else select.add(new Option(service, service, true, true));
      if (!message.value.trim()) message.value = fill(cfg.prefill, { servicio: service });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      button.disabled = true;
      label.textContent = cfg.sending;
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, kind: 'contacto' }),
        });
        if (!res.ok) throw new Error(String(res.status));
        track('formulario_enviado', { interes: data.service ?? '' });
        form.reset();
        showToast(cfg.success);
      } catch {
        showToast(cfg.error);
      } finally {
        button.disabled = false;
        label.textContent = idle;
      }
    });
  });
</script>
