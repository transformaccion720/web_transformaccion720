---
/**
 * Menú superior del mockup: barra translúcida azul noche, píldoras, desplegables (Servicios, Hub),
 * botón DIAGNÓSTICO (abre el Centro de Diagnóstico) y CONVERSEMOS (WhatsApp). Todo sale del CMS.
 */
import { ChevronDown, Menu, X } from 'lucide-react';
import Brand from './Brand.astro';
import Icon from '@/components/ui/Icon.astro';
import BrandIcon from '@/components/ui/BrandIcon.astro';
import { getSite } from '@/lib/content';
import { waLink } from '@/lib/format';
import { tone } from '@/lib/tones';

const site = await getSite();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const base = href.split(/[?#]/)[0]!.replace(/\/$/, '') || '/';
  return base === '/' ? path === '/' : path === base || path.startsWith(`${base}/`);
};
const wa = waLink(site.whatsapp, site.whatsappMessage);
const { diagnosticText, whatsappText } = site.header;
---

<header class="apple-glass-nav sticky top-0 z-50 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-[72px] items-center justify-between">
      <Brand site={site} tone="light" />

      {site.nav.length > 0 && (
        <nav
          aria-label="Navegación principal"
          class="hidden items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.05] px-2 py-1.5 text-[13.5px] font-medium lg:flex"
        >
          {site.nav.map((link, i) =>
            link.children.length ? (
              <div class="nav-dropdown relative">
                <a
                  href={link.href}
                  class:list={[
                    'apple-nav-pill flex items-center gap-1 rounded-full px-4 py-1.5 text-white/80 hover:text-white',
                    isActive(link.href) && 'nav-active',
                  ]}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  aria-haspopup="true"
                >
                  <span data-cms={`siteSettings.nav.${i}.label`}>{link.label}</span>
                  <ChevronDown size={14} className="opacity-70" aria-hidden="true" />
                </a>
                <div class="nav-dropdown-panel absolute top-full left-0 w-76 pt-3">
                  <div class="space-y-1 rounded-2xl border border-white/15 bg-[#0B1F3A]/92 p-2 shadow-apple-lg backdrop-blur-2xl">
                    {link.children.map((c) => (
                      <a
                        href={c.href}
                        class="flex w-full items-start gap-3 rounded-xl p-2.5 text-left transition hover:bg-white/10"
                      >
                        <span
                          class:list={[
                            'mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg',
                            tone(c.tone).glass,
                          ]}
                        >
                          <Icon name={c.icon} size={16} />
                        </span>
                        <span>
                          <span class="block text-xs font-bold text-white">{c.label}</span>
                          {c.desc && <span class="block text-[11px] text-slate-300">{c.desc}</span>}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                class:list={[
                  'apple-nav-pill rounded-full px-4 py-1.5 text-white/80 hover:text-white',
                  isActive(link.href) && 'nav-active',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
                data-cms={`siteSettings.nav.${i}.label`}
              >
                {link.label}
              </a>
            )
          )}
        </nav>
      )}

      <div class="hidden items-center gap-2.5 lg:flex">
        {diagnosticText && (
          <button
            type="button"
            data-open-diagnostic="horas"
            class="rounded-full bg-brand-orange px-4 py-2 text-xs font-extrabold tracking-wide text-brand-deep shadow-sm transition hover:bg-amber-400 hover:shadow-md"
            data-cms="siteSettings.header.diagnosticText"
          >
            {diagnosticText}
          </button>
        )}
        {wa && whatsappText && (
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/90 px-4 py-2 text-xs font-bold tracking-wide text-white shadow-sm transition hover:bg-emerald-400"
          >
            <BrandIcon name="whatsapp" size={16} mono />
            <span data-cms="siteSettings.header.whatsappText">{whatsappText}</span>
          </a>
        )}
      </div>

      <button
        id="mobile-menu-btn"
        type="button"
        class="rounded-xl p-2 text-white/90 hover:bg-white/10 focus:outline-none lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu size={24} className="menu-open" aria-hidden="true" />
        <X size={24} className="menu-close hidden" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden space-y-2 border-t border-white/10 bg-[#071528] px-4 py-4 lg:hidden">
    {site.nav
      .flatMap((link) => [
        ...(link.mobileHidden ? [] : [{ label: link.label, href: link.href }]),
        ...link.children.filter((c) => c.mobileLabel).map((c) => ({ label: c.mobileLabel, href: c.href })),
      ])
      .map((l) => (
        <a
          href={l.href}
          class="block w-full rounded-xl px-4 py-2.5 text-left text-sm font-semibold hover:bg-white/10"
          data-mobile-link
        >
          {l.label}
        </a>
      ))}
    <div class="flex gap-2 pt-3">
      {diagnosticText && (
        <button
          type="button"
          data-open-diagnostic="horas"
          data-mobile-link
          class="flex-1 rounded-xl bg-brand-orange py-2.5 text-xs font-extrabold text-brand-deep"
        >
          {diagnosticText}
        </button>
      )}
      {site.whatsapp && whatsappText && (
        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 rounded-xl bg-emerald-500 py-2.5 text-center text-xs font-bold text-white"
        >
          {whatsappText}
        </a>
      )}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const toggle = (open?: boolean) => {
    if (!btn || !menu) return;
    const next = open ?? menu.classList.contains('hidden');
    menu.classList.toggle('hidden', !next);
    btn.setAttribute('aria-expanded', String(next));
    btn.setAttribute('aria-label', next ? 'Cerrar menú' : 'Abrir menú');
    btn.querySelector('.menu-open')?.classList.toggle('hidden', next);
    btn.querySelector('.menu-close')?.classList.toggle('hidden', !next);
  };
  btn?.addEventListener('click', () => toggle());
  menu
    ?.querySelectorAll('[data-mobile-link]')
    .forEach((a) => a.addEventListener('click', () => toggle(false)));
</script>
