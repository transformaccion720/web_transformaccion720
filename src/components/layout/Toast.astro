---
/** Aviso flotante del mockup (reemplaza a alert()). Se muestra con showToast() de src/lib/toast.ts */
---

<div
  id="toast"
  role="status"
  aria-live="polite"
  class="fixed right-5 bottom-5 z-[100] hidden max-w-sm rounded-2xl border border-white/15 bg-brand-navy px-5 py-3.5 text-xs font-semibold text-white shadow-apple-lg"
>
  <span id="toast-message"></span>
</div>
