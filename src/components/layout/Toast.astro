---
/** Aviso flotante del mockup (reemplaza a alert()). Se muestra con showToast() de src/lib/toast.ts */
---

<div
  id="toast"
  role="status"
  aria-live="polite"
  class="fixed inset-x-4 top-20 z-[100] mx-auto sm:top-auto sm:bottom-6 hidden w-fit max-w-sm text-center sm:bottom-6 rounded-2xl border border-white/15 bg-brand-navy px-5 py-3.5 text-xs font-semibold text-white shadow-apple-lg"
>
  <span id="toast-message"></span>
</div>
