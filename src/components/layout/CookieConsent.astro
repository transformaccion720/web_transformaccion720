---
/**
 * Aviso de cookies + Google Analytics 4 (CMS → Configuración general → Analítica y cookies).
 * Sin ID de medición no se muestra nada. GA4 solo se carga si el visitante acepta (Ley 29733);
 * la decisión se guarda en su navegador y se cambia desde "Preferencias de cookies" en el pie.
 * También mide los clics hacia WhatsApp de toda la web (evento clic_whatsapp).
 */
import { getSite } from '@/lib/content';

const { analytics } = await getSite();
const GA_ID = /^G-[A-Z0-9]+$/i.test(analytics.gaId.trim()) ? analytics.gaId.trim() : '';
---

{GA_ID && (
  <div
    id="cookie-banner"
    role="dialog"
    aria-live="polite"
    aria-label="Aviso de cookies"
    hidden
    class="fixed inset-x-3 bottom-3 z-[120] mx-auto max-w-xl rounded-2xl border border-gray-200 bg-white p-4 text-ink shadow-2xl sm:bottom-5 sm:p-5"
  >
    <p class="text-[13px] leading-relaxed text-gray-700">
      <span data-cms="siteSettings.analytics.cookieText">{analytics.cookieText}</span>{' '}
      <a
        href="/legal/politica-de-privacidad"
        class="font-semibold text-brand-700 underline underline-offset-2"
      >
        {analytics.cookieMore}
      </a>
    </p>
    <div class="mt-3 flex flex-wrap justify-end gap-2">
      <button
        type="button"
        data-consent="denied"
        class="rounded-full border border-gray-300 px-4 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50"
      >
        {analytics.cookieReject}
      </button>
      <button
        type="button"
        data-consent="granted"
        class="rounded-full bg-brand-700 px-5 py-2 text-xs font-semibold text-white transition hover:bg-brand-800"
      >
        {analytics.cookieAccept}
      </button>
    </div>
  </div>
)}

{GA_ID && <script is:inline define:vars={{ GA_ID }}>
  (() => {
    // Ni en el CMS ni en su vista previa
    if (window.parent !== window || location.pathname.startsWith('/keystatic')) return;
    const KEY = 'cookie-consent';
    const banner = document.getElementById('cookie-banner');
    const read = () => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    };
    const save = (v) => {
      try {
        localStorage.setItem(KEY, v);
      } catch {
        // sin almacenamiento: la decisión dura solo esta visita
      }
    };

    let loaded = false;
    const loadGA = () => {
      if (loaded) return;
      loaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        // gtag necesita el objeto "arguments" original
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID, { anonymize_ip: true });
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
    };

    const choice = read();
    if (choice === 'granted') loadGA();
    else if (choice !== 'denied') banner.hidden = false;

    banner.addEventListener('click', (e) => {
      const v = e.target.closest('[data-consent]')?.dataset.consent;
      if (!v) return;
      save(v);
      banner.hidden = true;
      if (v === 'granted') loadGA();
      else if (loaded) location.reload(); // apaga GA si antes estaba aceptado
    });

    document.addEventListener('click', (e) => {
      // Clics hacia WhatsApp desde cualquier botón o enlace de la web
      if (e.target.closest('a[href*="wa.me/"]') && window.gtag)
        window.gtag('event', 'clic_whatsapp', { origen: location.pathname });
      // Enlace "Preferencias de cookies" del pie de página
      if (e.target.closest('[data-cookie-settings]')) {
        e.preventDefault();
        banner.hidden = false;
      }
    });
  })();
</script>}
