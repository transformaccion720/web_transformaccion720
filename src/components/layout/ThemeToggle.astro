---
/**
 * Modo claro/oscuro (abajo a la izquierda), como el mockup: recuerda la elección; si nunca eligió,
 * se pone oscuro de 7 pm a 6 am. El tema inicial lo aplica ThemeScript (en <head>) para no parpadear.
 */
---

<button
  id="theme-toggle"
  type="button"
  title="Cambiar modo claro/oscuro"
  aria-label="Cambiar modo claro/oscuro"
  class="fixed bottom-5 left-5 z-40 flex size-11 items-center justify-center rounded-full border border-slate-200 bg-white/90 text-lg shadow-apple backdrop-blur-md transition hover:scale-105 dark:border-slate-700 dark:bg-slate-800/90"
>
  <span class="dark:hidden" aria-hidden="true">
    🌙
  </span>
  <span class="hidden dark:inline" aria-hidden="true">
    ☀️
  </span>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    try {
      localStorage.setItem('ta720_theme', dark ? 'dark' : 'light');
    } catch {
      /* sin almacenamiento */
    }
  });
</script>
