---
/**
 * Marco de las páginas legales (TA720): portada aurora + selector Términos / Privacidad / Libro + hoja blanca.
 * `kicker`, `title` y `subtitle` van en la portada; el contenido va en la hoja.
 */
import { ArrowLeft, BookOpen } from 'lucide-react';
import { COMPLAINTS_SLUG, getComplaintsBook, getLegalPages } from '@/lib/content';

interface Props {
  current: string;
  kicker?: string;
  title: string;
  subtitle?: string;
  cmsPrefix?: string;
}

const { current, kicker, title, subtitle, cmsPrefix } = Astro.props;
const [pages, book] = await Promise.all([getLegalPages(), getComplaintsBook()]);
const tabs = [
  ...pages.map((p) => ({ id: p.id, label: p.data.title, book: false })),
  { id: COMPLAINTS_SLUG, label: book.tabLabel, book: true },
];
---

<section class="hero-aurora py-12 text-white">
  <div class="tech-grid-overlay pointer-events-none absolute inset-0"></div>
  <div class="relative z-10 mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
    {kicker && (
      <span
        class="text-xs font-extrabold tracking-[0.2em] text-amber-300 uppercase"
        data-cms={cmsPrefix && `${cmsPrefix}.kicker`}
      >
        {kicker}
      </span>
    )}
    <h1
      class="mt-2 font-display text-3xl font-black sm:text-4xl"
      data-cms={cmsPrefix && `${cmsPrefix}.title`}
    >
      {title}
    </h1>
    {subtitle && <p class="mt-2 text-xs text-slate-300 sm:text-sm">{subtitle}</p>}
  </div>
</section>

<section class="bg-brand-cream py-12 dark:bg-slate-950">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="back-pill">
        <ArrowLeft size={16} aria-hidden="true" />
        <span data-cms="complaintsBook.backText">{book.backText}</span>
      </a>
      <nav aria-label="Páginas legales" class="apple-segment">
        {tabs.map((t) => (
          <a
            href={`/legal/${t.id}`}
            aria-current={t.id === current ? 'page' : undefined}
            class:list={[
              'apple-segment-btn flex items-center gap-1.5 !px-4 !py-1.5 !text-xs',
              t.id === current && 'active',
            ]}
          >
            {t.book && <BookOpen size={13} aria-hidden="true" />}
            {t.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-7 text-slate-800 shadow-apple sm:p-10 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
      <slot />
    </div>
  </div>
</section>
