---
/** Isotipo oficial TA720: abeja-cohete con estela. `light` = versión para fondos oscuros (menú). */
interface Props {
  size?: number;
  class?: string;
  light?: boolean;
}

const { size = 40, class: className = '', light = false } = Astro.props;
const gid = `ta-trail-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  width={size}
  height={size}
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M10 38C4 46 8 56 19 56C28 56 35 50 42 44"
    stroke={light ? `url(#${gid})` : '#10B981'}
    stroke-width="4.5"
    stroke-linecap="round"
  ></path>
  <ellipse
    cx="22"
    cy="24"
    rx="10"
    ry="5.5"
    transform="rotate(-24 22 24)"
    fill="#DBEAFE"
    fill-opacity="0.9"
    stroke="#0F172A"
    stroke-width="1.5"
  ></ellipse>
  <ellipse
    cx="38"
    cy="36"
    rx="9"
    ry="4.5"
    transform="rotate(64 38 36)"
    fill="#DBEAFE"
    fill-opacity="0.9"
    stroke="#0F172A"
    stroke-width="1.5"
  ></ellipse>
  <path
    d="M44 12C35 13 24 23 21 37C35 34 45 23 44 12Z"
    fill="#F59E0B"
    stroke="#0F172A"
    stroke-width="1.8"
  ></path>
  <path d="M27 25L37 30M23 31L31 35" stroke="#0F172A" stroke-width="3.2" stroke-linecap="round"></path>
  <path d="M44 12C41 12.5 38.5 14 36.5 16L41 20.5C43 18 44 15 44 12Z" fill="#0F172A"></path>
  <circle cx="35.5" cy="21.5" r="3.2" fill="#E0F2FE" stroke="#0F172A" stroke-width="1.6"></circle>
  {light && (
    <>
      <path d="M41 12L42 6M44 14L49 12" stroke="#F8FAFC" stroke-width="1.6" stroke-linecap="round"></path>
      <circle cx="42" cy="5.5" r="1.7" fill="#F8FAFC"></circle>
      <circle cx="49.5" cy="11.5" r="1.7" fill="#F8FAFC"></circle>
      <defs>
        <linearGradient id={gid} x1="8" y1="38" x2="42" y2="54" gradientUnits="userSpaceOnUse">
          <stop stop-color="#10B981"></stop>
          <stop offset="1" stop-color="#38BDF8"></stop>
        </linearGradient>
      </defs>
    </>
  )}
</svg>
